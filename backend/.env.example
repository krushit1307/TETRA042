# Copy to .env for local development (never commit .env)

# Optional — only if using private Hugging Face model repos
HF_TOKEN=

# Optional premium TTS (edge-tts / gTTS work without this)
ELEVENLABS_API_KEY=

# Use fine-tuned Whisper from trained_models/whisper_multilingual (0 = use openai/whisper-small)
USE_WHISPER_FINETUNE=0

# Server port (default 7860 for HF Space compatibility)
PORT=7860
